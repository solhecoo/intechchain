---
import { useTranslations, type Lang } from '../i18n/ui';
import { metricsData } from '../content/metrics';
import Icon from './Icon.astro';
import MatrixRain from './MatrixRain.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="about" class="relative scroll-mt-24 overflow-hidden border-t border-line/40 bg-ink-900/40 py-20 sm:py-28">
  <MatrixRain parallax={0.05} opacity={0.14} />
  <div class="container-x">
    <div class="grid items-center gap-12 lg:grid-cols-2">
      <div data-reveal>
        <p class="eyebrow mb-3">{t('about.eyebrow')}</p>
        <h2 class="text-3xl font-bold leading-tight tracking-tight text-white sm:text-4xl" data-kinetic>
          {t('about.title')}
        </h2>
        <p class="mt-6 text-pretty leading-relaxed text-slate-300">{t('about.body')}</p>
        <p class="mt-4 text-pretty leading-relaxed text-slate-400">{t('about.note')}</p>
      </div>

      <!-- Métricas -->
      <div class="grid gap-5 sm:grid-cols-2">
        {
          metricsData.map((m, i) => (
            <div class="card bg-surface-2/60" data-reveal data-reveal-delay={i * 120}>
              <span class="inline-grid h-11 w-11 place-items-center rounded-xl bg-brand-500/15 text-brand-300">
                <Icon name={m.icon} class="h-6 w-6" />
              </span>
              <h3 class="mt-4 text-lg font-semibold text-white">
                {t(`metrics.items.${m.key}.label`)}
              </h3>
              <p class="mt-2 text-sm text-slate-300">
                {t(`metrics.items.${m.key}.description`)}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
