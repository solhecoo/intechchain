---
import { useTranslations, whatsappUrl, getDict, type Lang } from '../i18n/ui';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const dict = getDict(lang);
const waContact = whatsappUrl(dict.contact.whatsappMessage);
const points: string[] = dict.ai.points;
---

<section id="ai" class="relative scroll-mt-24 overflow-hidden border-t border-line/40 py-20 sm:py-28">
  <div class="container-x">
    <div class="grid items-center gap-12 lg:grid-cols-2">
      <!-- Bloques 3D flotando (sin marco, fundidos con el fondo) -->
      <div
        class="relative order-last flex justify-center [perspective:1100px] lg:order-first"
        data-reveal
        data-ai-stage
      >
        <div
          class="pointer-events-none absolute left-1/2 top-1/2 -z-10 h-80 w-80 -translate-x-1/2 -translate-y-1/2 animate-pulse rounded-full bg-brand-600/20 blur-[110px]"
          aria-hidden="true"
        >
        </div>
        <div data-parallax="-0.05" class="w-full max-w-lg">
          <div data-ai-float class="will-change-transform [transform-style:preserve-3d]">
            <img
              src={`${import.meta.env.BASE_URL}blocks.webp`}
              alt={t('ai.imageAlt')}
              width="1400"
              height="1400"
              loading="lazy"
              decoding="async"
              class="w-full select-none will-change-transform"
              style="-webkit-mask-image:radial-gradient(circle at 50% 48%, #000 46%, transparent 72%);mask-image:radial-gradient(circle at 50% 48%, #000 46%, transparent 72%)"
              data-ai-img
            />
          </div>
        </div>
      </div>

      <!-- Texto -->
      <div data-reveal>
        <p class="eyebrow mb-3">{t('ai.eyebrow')}</p>
        <h2 class="text-balance text-3xl font-bold leading-tight tracking-tight text-white sm:text-4xl" data-kinetic>
          {t('ai.title')}
        </h2>
        <p class="mt-5 max-w-lg text-pretty leading-relaxed text-slate-300">{t('ai.body')}</p>

        <ul class="mt-7 space-y-3">
          {
            points.map((point) => (
              <li class="flex items-center gap-3 text-slate-200">
                <span class="inline-grid h-7 w-7 shrink-0 place-items-center rounded-full bg-brand-500/15 text-brand-300">
                  <Icon name="check" class="h-4 w-4" />
                </span>
                {point}
              </li>
            ))
          }
        </ul>

        <a href={waContact} target="_blank" rel="noopener" class="btn-primary mt-8" data-magnetic>
          {t('ai.cta')}
          <Icon name="arrow" class="h-4 w-4" />
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  const stage = document.querySelector<HTMLElement>('[data-ai-stage]');
  const floatEl = document.querySelector<HTMLElement>('[data-ai-float]');
  const img = document.querySelector<HTMLElement>('[data-ai-img]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (stage && floatEl && img && !reduce) {
    // Flotación + balanceo + respiración
    floatEl.animate(
      [
        { transform: 'translateY(0) rotateZ(-1deg) scale(1)' },
        { transform: 'translateY(-18px) rotateZ(1deg) scale(1.015)' },
        { transform: 'translateY(0) rotateZ(-1deg) scale(1)' },
      ],
      { duration: 6000, iterations: Infinity, easing: 'ease-in-out' },
    );

    // Inclinación 3D siguiendo el cursor
    const cur = { rx: 0, ry: 0 };
    const tgt = { rx: 0, ry: 0 };
    let active = false;
    const tick = () => {
      cur.rx += (tgt.rx - cur.rx) * 0.08;
      cur.ry += (tgt.ry - cur.ry) * 0.08;
      img.style.transform = `rotateX(${cur.rx.toFixed(2)}deg) rotateY(${cur.ry.toFixed(2)}deg)`;
      if (Math.abs(tgt.rx - cur.rx) > 0.04 || Math.abs(tgt.ry - cur.ry) > 0.04) {
        requestAnimationFrame(tick);
      } else {
        active = false;
      }
    };
    const start = () => {
      if (!active) {
        active = true;
        requestAnimationFrame(tick);
      }
    };
    stage.addEventListener(
      'pointermove',
      (e) => {
        const r = stage.getBoundingClientRect();
        tgt.ry = ((e.clientX - r.left) / r.width - 0.5) * 18;
        tgt.rx = -((e.clientY - r.top) / r.height - 0.5) * 14;
        start();
      },
      { passive: true },
    );
    stage.addEventListener(
      'pointerleave',
      () => {
        tgt.rx = 0;
        tgt.ry = 0;
        start();
      },
      { passive: true },
    );
  }
</script>
