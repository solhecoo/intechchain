---
import { useTranslations, type Lang } from '../i18n/ui';
import { clients } from '../content/clients';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="clients" class="scroll-mt-24 border-y border-line/50 bg-ink-900/40 py-16 sm:py-20">
  <div class="container-x">
    <div class="mx-auto max-w-2xl text-center" data-reveal>
      <p class="eyebrow mb-3">{t('clients.eyebrow')}</p>
      <h2 class="text-2xl font-bold tracking-tight text-white sm:text-3xl" data-kinetic>
        {t('clients.title')}
      </h2>
      <p class="mt-4 text-slate-400">{t('clients.body')}</p>
    </div>

    {
      clients.length > 0 ? (
        <ul class="mt-12 grid grid-cols-2 items-center gap-8 sm:grid-cols-3 lg:grid-cols-5">
          {clients.map((c) => (
            <li class="flex items-center justify-center">
              {c.url ? (
                <a href={c.url} target="_blank" rel="noopener" aria-label={c.name}>
                  <img
                    src={c.logo}
                    alt={c.name}
                    loading="lazy"
                    decoding="async"
                    class="h-10 w-auto opacity-70 grayscale transition hover:opacity-100 hover:grayscale-0"
                  />
                </a>
              ) : (
                <img
                  src={c.logo}
                  alt={c.name}
                  loading="lazy"
                  decoding="async"
                  class="h-10 w-auto opacity-70 grayscale transition hover:opacity-100 hover:grayscale-0"
                />
              )}
            </li>
          ))}
        </ul>
      ) : (
        <p class="mt-10 text-center text-sm text-slate-500">{t('clients.empty')}</p>
      )
    }
  </div>
</section>
