---
/**
 * Cursor personalizado (anillo + punto) con seguimiento suave y crecimiento
 * sobre elementos interactivos. Solo en dispositivos con puntero fino; se
 * oculta en táctil y con prefers-reduced-motion (vía CSS).
 */
---

<div class="cursor-ring" data-cursor-ring aria-hidden="true"></div>
<div class="cursor-dot" data-cursor-dot aria-hidden="true"></div>

<script>
  const fine = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const ring = document.querySelector<HTMLElement>('[data-cursor-ring]');
  const dot = document.querySelector<HTMLElement>('[data-cursor-dot]');

  if (fine && !reduceMotion && ring && dot) {
    document.documentElement.classList.add('has-cursor');

    let mx = window.innerWidth / 2;
    let my = window.innerHeight / 2;
    let rx = mx;
    let ry = my;

    window.addEventListener(
      'pointermove',
      (e) => {
        mx = e.clientX;
        my = e.clientY;
        dot.style.transform = `translate(${mx}px, ${my}px)`;
      },
      { passive: true },
    );

    const loop = () => {
      rx += (mx - rx) * 0.18;
      ry += (my - ry) * 0.18;
      ring.style.transform = `translate(${rx}px, ${ry}px)`;
      requestAnimationFrame(loop);
    };
    requestAnimationFrame(loop);

    // Crece sobre elementos interactivos
    const hoverSel = 'a, button, [data-magnetic], [data-card], input, textarea, select';
    document.querySelectorAll(hoverSel).forEach((el) => {
      el.addEventListener('pointerenter', () => ring.classList.add('is-hover'));
      el.addEventListener('pointerleave', () => ring.classList.remove('is-hover'));
    });

    // Oculta al salir de la ventana
    document.addEventListener('pointerleave', () => {
      ring.style.opacity = dot.style.opacity = '0';
    });
    document.addEventListener('pointerenter', () => {
      ring.style.opacity = dot.style.opacity = '1';
    });
  }
</script>
