---
import { useTranslations, type Lang } from '../i18n/ui';
import Logo from './Logo.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const year = 2026;

const navItems = [
  { href: '#services', label: t('nav.services') },
  { href: '#about', label: t('nav.about') },
  { href: '#projects', label: t('nav.projects') },
  { href: '#clients', label: t('nav.clients') },
  { href: '#contact', label: t('nav.contact') },
];
const home = lang === 'es' ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}en/`;
---

<footer class="border-t border-line/60 bg-ink-900/60 pt-14 pb-10">
  <div class="container-x">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
      <div class="lg:col-span-2">
        <a href={home} class="inline-flex items-center text-white" aria-label="Intechchain — inicio">
          <Logo class="h-7 w-auto" />
        </a>
        <p class="mt-4 max-w-sm text-sm text-slate-400">{t('footer.tagline')}</p>
      </div>

      <div>
        <h3 class="text-sm font-semibold text-white">{t('footer.navTitle')}</h3>
        <ul class="mt-4 space-y-2 text-sm">
          {
            navItems.map((item) => (
              <li>
                <a href={item.href} class="text-slate-400 transition-colors hover:text-white">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h3 class="text-sm font-semibold text-white">{t('footer.contactTitle')}</h3>
        <ul class="mt-4 space-y-2 text-sm">
          <li>
            <a href="mailto:junior@intechchain.com" class="text-slate-400 transition-colors hover:text-white">
              junior@intechchain.com
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-12 border-t border-line/60 pt-6 text-center text-xs text-slate-500">
      © {year} Intechchain. {t('footer.rights')}
    </div>
  </div>
</footer>
