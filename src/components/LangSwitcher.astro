---
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

// Rutas equivalentes en cada idioma (sitio de una sola página)
const base = import.meta.env.BASE_URL;
const links: { code: Lang; href: string; label: string }[] = [
  { code: 'es', href: base, label: 'ES' },
  { code: 'en', href: `${base}en/`, label: 'EN' },
];
---

<div
  class="flex items-center rounded-full border border-line bg-white/5 p-0.5 text-xs font-semibold"
  role="group"
  aria-label={t('lang.label')}
>
  {
    links.map((l) => (
      <a
        href={l.href}
        hreflang={l.code}
        aria-current={l.code === lang ? 'true' : undefined}
        class:list={[
          'rounded-full px-2.5 py-1 transition-colors',
          l.code === lang ? 'bg-brand-500 text-white' : 'text-slate-300 hover:text-white',
        ]}
      >
        {l.label}
      </a>
    ))
  }
</div>
