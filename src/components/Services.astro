---
import { useTranslations, type Lang } from '../i18n/ui';
import { services } from '../content/services';
import Icon from './Icon.astro';
import CircuitPaths from './CircuitPaths.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="services" class="relative scroll-mt-24 overflow-hidden border-t border-line/40 py-20 sm:py-28">
  <CircuitPaths class="-right-16 top-0 h-[26rem] w-[26rem] opacity-60" parallax={0.07} />
  <div class="container-x">
    <div class="mx-auto max-w-2xl text-center" data-reveal>
      <p class="eyebrow mb-3">{t('services.eyebrow')}</p>
      <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl" data-kinetic>
        {t('services.title')}
      </h2>
      <p class="mt-5 text-pretty text-slate-300">{t('services.body')}</p>
    </div>

    <ul class="services-grid mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        services.map((s, i) => (
          <li
            class="service-card group relative flex flex-col overflow-hidden rounded-[var(--radius-card)] border border-line bg-surface/60 p-7 transition-all duration-300 hover:-translate-y-1.5 hover:border-brand-500/60 hover:bg-surface hover:shadow-2xl hover:shadow-brand-900/40"
            data-reveal
            data-reveal-delay={i * 100}
          >
            {/* brillo que sigue al cursor */}
            <span
              class="pointer-events-none absolute -inset-px opacity-0 transition-opacity duration-300 group-hover:opacity-100"
              style="background: radial-gradient(20rem 20rem at var(--mx,50%) var(--my,0%), rgba(59,111,255,0.14), transparent 60%);"
              aria-hidden="true"
            />
            {/* índice */}
            <span class="absolute right-6 top-6 font-mono text-xs tabular-nums text-slate-600 transition-colors duration-300 group-hover:text-brand-400">
              {String(i + 1).padStart(2, '0')}
            </span>

            <span class="service-icon mb-5 inline-grid h-12 w-12 place-items-center rounded-xl bg-brand-500/15 text-brand-300 transition-all duration-300 group-hover:scale-110 group-hover:bg-brand-500 group-hover:text-white group-hover:shadow-lg group-hover:shadow-brand-500/40">
              <Icon name={s.icon} class="h-6 w-6" />
            </span>

            <h3 class="text-xl font-semibold text-white">
              {t(`services.items.${s.key}.title`)}
            </h3>
            <p class="mt-3 flex-1 text-sm leading-relaxed text-slate-300">
              {t(`services.items.${s.key}.description`)}
            </p>

            <a
              href="#contact"
              class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-brand-300 opacity-0 transition-all duration-300 group-hover:opacity-100"
            >
              {t('services.cta')}
              <Icon name="arrow" class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1" />
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<script>
  // Brillo que sigue al cursor dentro de cada tarjeta.
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!reduce) {
    document.querySelectorAll<HTMLElement>('.service-card').forEach((card) => {
      card.addEventListener('pointermove', (e) => {
        const r = card.getBoundingClientRect();
        card.style.setProperty('--mx', `${e.clientX - r.left}px`);
        card.style.setProperty('--my', `${e.clientY - r.top}px`);
      });
    });
  }
</script>
